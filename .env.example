# CIEM — variáveis de ambiente
# Copie para .env e preencha conforme seu ambiente

# Core
CIEM_SECRET_KEY=change-me-in-production
CONFIG_PATH=./config

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Zabbix (módulo)
ZABBIX_URL=https://zabbix.exemplo.local
ZABBIX_USERNAME=
ZABBIX_PASSWORD=

# Nagios (módulo)
NAGIOS_API_KEY=

# TOPdesk (módulo)
TOPDESK_USERNAME=
TOPDESK_PASSWORD=
TOPDESK_APPLICATION_PASSWORD=

# CIEM_GRAFANA_TOKEN=seu-token-seguro

# Guacamole
GUACAMOLE_INCLUDE_OBSERVERS=false

# Inventário (módulo)
INVENTORY_API_KEY=

# Syslog (módulo)
SYSLOG_API_KEY=
