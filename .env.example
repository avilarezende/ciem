# =============================================================================
# Conversador PoP-SE — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores necessários.
# Nunca commite o arquivo .env (ele está no .gitignore).
# =============================================================================

# --- Identificação do projeto Docker Compose ---
COMPOSE_PROJECT_NAME=conversador-popse

# Porta HTTP da interface web (Apache)
WEB_PORT=8080

# Porta da API do engine (FastAPI) — uso interno ou debug
ENGINE_PORT=8000

# =============================================================================
# PROVEDOR DE IA (LLM)
# Escolha UM provedor definindo LLM_PROVIDER.
# Valores: ollama | gemini | openai | azure | grok
# =============================================================================
LLM_PROVIDER=ollama

# --- Ollama (local, gratuito) ---
# URL do serviço Ollama dentro da rede Docker
OLLAMA_HOST=http://ollama:11434
# Modelo a baixar na primeira execução: docker compose exec ollama ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# --- Google Gemini (remoto, tier gratuito disponível) ---
# Obtenha em: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# LLM_PROVIDER=gemini

# --- OpenAI (remoto) ---
# Obtenha em: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=          # opcional: endpoint compatível OpenAI (proxy/gateway)
# LLM_PROVIDER=openai

# --- Azure OpenAI (remoto, corporativo) ---
# Portal Azure → seu recurso OpenAI → Keys and Endpoint
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=nome-do-deployment
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# LLM_PROVIDER=azure

# --- xAI Grok (remoto) ---
# Obtenha em: https://console.x.ai
# GROK_API_KEY=
# GROK_MODEL=grok-2-latest
# GROK_BASE_URL=https://api.x.ai/v1
# LLM_PROVIDER=grok

# =============================================================================
# BANCO DE DADOS (memória persistente de usuários)
# =============================================================================
POSTGRES_USER=popse
POSTGRES_PASSWORD=altere_em_producao_segura
POSTGRES_DB=conversador
DATABASE_URL=postgresql+asyncpg://popse:altere_em_producao_segura@postgres:5432/conversador

# =============================================================================
# RAG — armazenamento vetorial
# =============================================================================
CHROMA_PATH=/data/chroma
POPSE_CONTEXT_URL=https://www.pop-se.rnp.br

# Intervalo de sincronização dos coletores (segundos)
SOURCES_SYNC_INTERVAL=600

# =============================================================================
# ZABBIX — manutenções e problemas ativos
# URL base SEM barra final. Ex.: https://zabbix.pop-se.rnp.br
# =============================================================================
ZABBIX_URL=
ZABBIX_USER=
ZABBIX_PASSWORD=
# Janela de busca de manutenções programadas (dias à frente)
ZABBIX_MAINTENANCE_DAYS=30

# =============================================================================
# CACTI — hosts e gráficos de monitoração
# =============================================================================
CACTI_URL=
CACTI_USER=
CACTI_PASSWORD=

# =============================================================================
# GRAFANA — alertas e anotações operacionais
# Crie um Service Account Token em Grafana → Administration → Service Accounts
# =============================================================================
GRAFANA_URL=
GRAFANA_API_KEY=
GRAFANA_ANNOTATION_DAYS=30

# =============================================================================
# MRTG / TOPDESK (stubs — implementação futura)
# =============================================================================
MRTG_URL=
TOPDESK_URL=
TOPDESK_API_KEY=

# =============================================================================
# E-mail Microsoft 365 (Graph API) — módulo module-email-microsoft
# Registre app em: https://portal.azure.com → App registrations
# Permissões: Mail.Read (application)
# =============================================================================
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=info@pop-se.rnp.br
EMAIL_SYNC_INTERVAL=900

# =============================================================================
# CANAIS DE MENSAGERIA (ative o profile correspondente no docker compose)
# =============================================================================
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
