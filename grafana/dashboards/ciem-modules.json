                  { "type": "value", "options": { "false": { "color": "gray", "text": "DESABILITADO" } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "/grafana/modules",
          "columns": [
            { "selector": "module", "text": "Módulo", "type": "string" },
            { "selector": "enabled", "text": "Status Config", "type": "boolean" },
            { "selector": "health.status", "text": "Saúde", "type": "string" },
